#include <iostream>
#include <thread>

// global variable integer
int sum = 0;

// function that will take an integer parameter and add that value to the global variable.
void add(int value)
{
    sum += value;
}

int main()
{
    // creating the three threads with name and parameters inside to pass the void function to the threads
    std::thread t1(add, 21);
    std::thread t2(add, 14);
    std::thread t3(add, 67);

    std::cout << "Displaying the sum of three combined threads" << std::endl;
    std::cout << "Thread 1: " << sum << std::endl;
    t1.join();
    std::cout << "Thread 2: " << sum << std::endl;
    t2.join();
    std::cout << "Thread 3: " << sum << std::endl;
    t3.join();
    return 0;
}